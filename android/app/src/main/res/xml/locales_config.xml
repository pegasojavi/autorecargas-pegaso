<?xml version="1.0" encoding="utf-8"?>
<!--
  Lista declarada de idiomas soportados (CLAUDE.md sección 6).

  Por qué existe este fichero en vez de leer `resources.assets.locales`
  directamente (que era el plan original): `assets.locales` devuelve TODOS
  los locales para los que existe algún recurso en el APK final, incluidos
  los que traen las propias librerías (AppCompat/Material traducen sus
  textos internos — "OK", "Cancelar", etc. — a 60-90 idiomas) aunque
  nosotros no hayamos traducido nada nuestro a esos idiomas. Sin este
  fichero, el selector mostraba "el listado completo de los del mundo"
  (bug real detectado en dispositivo).

  `LocaleManagerCompat.getApplicationSupportedLocales()` sí lee
  exactamente esta lista (vía `android:localeConfig` en el manifest),
  compatible con versiones antiguas de Android. Sigue siendo una única
  fuente de verdad declarativa, no una lista dentro del código Kotlin:
  añadir un idioma nuevo es añadir aquí una línea + su
  `values-<lang>/strings.xml`, nada más.
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="es" />
    <!-- 24 idiomas oficiales de la UE (los 22 restantes tras en/es), más
         idiomas cooficiales de estados miembros — a petición del usuario
         (2026-09-10). Traducciones generadas sin revisión de hablante
         nativo (asunción ya documentada en CLAUDE.md sección 6/12 para
         irlandés/maltés, ahora extendida de facto a todo este lote) —
         pendiente de QA nativa antes de publicar. -->
    <locale android:name="fr" />
    <locale android:name="de" />
    <locale android:name="it" />
    <locale android:name="pt" />
    <locale android:name="nl" />
    <locale android:name="pl" />
    <locale android:name="ro" />
    <locale android:name="cs" />
    <locale android:name="sk" />
    <locale android:name="hu" />
    <locale android:name="bg" />
    <locale android:name="el" />
    <locale android:name="hr" />
    <locale android:name="sl" />
    <locale android:name="sv" />
    <locale android:name="da" />
    <locale android:name="fi" />
    <locale android:name="et" />
    <locale android:name="lv" />
    <locale android:name="lt" />
    <locale android:name="ga" />
    <locale android:name="mt" />
    <!-- Cooficiales de estados miembros de la UE (no idiomas oficiales de
         la UE en sí) — sin precedente previo en este proyecto, traducidos
         desde cero. -->
    <locale android:name="ca" />
    <locale android:name="eu" />
    <locale android:name="gl" />
    <locale android:name="lb" />
    <locale android:name="fy" />
</locale-config>
